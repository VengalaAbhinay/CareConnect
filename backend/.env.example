PORT=8000
DB_URL=mongodb+srv://<username>:<password>@<cluster-url>/careconnect?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY=7d
NODE_ENV=development

# Optional: enables real Claude-powered request classification & provider
# ranking (backend/services/aiService.js). Leave unset to use the built-in
# heuristic classifier/ranker, which works fully offline.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
