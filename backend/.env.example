PORT=8000
DB_URL=mongodb+srv://<username>:<password>@<cluster-url>/careconnect?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY=7d
NODE_ENV=development

# Optional: enables real Claude-powered request classification & provider
# ranking (backend/services/aiService.js). Leave unset to use the built-in
# heuristic classifier/ranker, which works fully offline.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: business timezone offset from UTC, in minutes. Used to compute
# "today" for availability/booking checks so a booking made at 1am IST for
# "today" isn't judged against the UTC calendar day. Default 330 = IST (UTC+5:30).
BUSINESS_TZ_OFFSET_MIN=330

# Optional: the largest refund (in the storefront currency) a support agent
# may approve on their own; above this a case must be escalated to operations.
# Default 2000.
SUPPORT_REFUND_LIMIT=2000

# Optional: where uploaded evidence/verification documents are stored on disk.
# Default: backend/uploads (created automatically, served at /uploads/*).
UPLOAD_DIR=
